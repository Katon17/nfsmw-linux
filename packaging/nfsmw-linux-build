#!/bin/bash
# nfsmw-linux-build: builds the native Linux executable of Need for Speed: Most Wanted
# (Black Edition) from YOUR OWN copy of the original Xbox game.
#
# The package ships no game code or proprietary assets. This script:
# 1. Extracts or locates default.xbe from your USA Black Edition ISO or folder.
# 2. Recompiles the x86 machine code to C++ using XboxXBE-Recomp.
# 3. Compiles the generated C++ files with clang++ / lld.
# 4. Links with the native SDL3 + Vulkan Linux desktop host into:
#      ~/.local/share/nfsmw-linux/bin/MOSTWANTED
#
# Usage:
#   nfsmw-linux-build [--gui] [--jobs N] [--force] [<game .iso or folder>]
set -euo pipefail

VERSION="@VERSION@"
DATA="${NFSMW_DATA_DIR:-/usr/share/nfsmw-linux}"
LIB="${NFSMW_LIB_DIR:-/usr/lib/nfsmw-linux}"
HOME_DIR="${NFSMW_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/nfsmw-linux}"
WORK="${XDG_CACHE_HOME:-$HOME/.cache}/nfsmw-linux"
USA_BLACK_SHA1="f636a16af04171089f879a4bed646e185c734233"
CXX="${CXX:-clang++}"
MARCH="@MARCH@"

GUI=0; JOBS=""; FORCE=0; SOURCE=""
while (($#)); do
    case "$1" in
        --gui) GUI=1 ;;
        --jobs) shift; JOBS="${1:-}" ;;
        --force) FORCE=1 ;;
        -h|--help) sed -n 2,13p "$0"; exit 0 ;;
        *) SOURCE="$1" ;;
    esac
    shift
done
[[ $GUI == 1 ]] && ! command -v zenity >/dev/null 2>&1 && GUI=0

say() { echo "  $*"; }
fail() {
    echo ""
    echo "  ========================================================"
    echo -e "  ERROR: $*"
    echo "  ========================================================"
    echo ""
    [[ $GUI == 1 ]] && zenity --error --title="Need for Speed: Most Wanted (Black Edition)" --width=500 --text="$*" 2>/dev/null
    exit 1
}

mkdir -p "$HOME_DIR/bin" "$HOME_DIR/game" "$WORK" || fail "cannot create $HOME_DIR or $WORK"
LOG="$WORK/build.log"
: > "$LOG"

echo ""
echo "  ======================================================================"
echo "    Need for Speed: Most Wanted Black Edition - Native Linux Builder"
echo "    Version ${VERSION} | Arch: ${MARCH}"
echo "  ======================================================================"
echo ""

# ------------------------------------------------------------------ Toolchain check
for t in "$CXX" ld.lld python3; do
    command -v "$t" >/dev/null 2>&1 || fail "$t is missing. Install via:\n  sudo apt install clang lld python3"
done
VK=""
for f in /usr/lib/x86_64-linux-gnu/libvulkan.so.1 /usr/lib64/libvulkan.so.1 /usr/lib/libvulkan.so.1; do
    [[ -e $f ]] && VK="$f" && break
done
[[ -n $VK ]] || fail "libvulkan.so.1 is missing. Install via:\n  sudo apt install libvulkan1 mesa-vulkan-drivers"

# ------------------------------------------------------------------ Locate game copy
find_game() {
    local dirs=()
    [[ -n ${NFSMW_GAME_DIR:-} ]] && dirs+=("$NFSMW_GAME_DIR")
    dirs+=("$HOME_DIR/game" "$HOME_DIR/assets" "$HOME/Games/MostWanted" "$HOME/Games/NFSMW" "$HOME/Downloads")
    for d in "${dirs[@]}"; do
        [[ -d $d ]] || continue
        for x in "$d"/default.xbe "$d"/DEFAULT.XBE "$d"/Default.xbe; do
            [[ -f $x ]] && { echo "$x"; return 0; }
        done
        local iso
        iso=$(find -L "$d" -maxdepth 1 -type f \( -iname '*most*wanted*.iso' -o -iname '*nfsmw*.iso' -o -iname '*.iso' \) 2>/dev/null | sort | head -n1)
        [[ -n $iso ]] && { echo "$iso"; return 0; }
    done
    return 1
}

if [[ -n $SOURCE ]]; then
    SOURCE=$(realpath "$SOURCE") || fail "$SOURCE does not exist"
    if [[ -d $SOURCE ]]; then
        [[ -f $SOURCE/default.xbe || -f $SOURCE/DEFAULT.XBE ]] || fail "$SOURCE has no default.xbe"
        rmdir "$HOME_DIR/game" 2>/dev/null || true
        [[ -e $HOME_DIR/game ]] || ln -s "$SOURCE" "$HOME_DIR/game"
        if [[ -f $SOURCE/default.xbe ]]; then
            SOURCE="$SOURCE/default.xbe"
        else
            SOURCE="$SOURCE/DEFAULT.XBE"
        fi
    else
        ln -sf "$SOURCE" "$HOME_DIR/game/$(basename "$SOURCE")"
    fi
fi
GAME_FILE="${SOURCE:-$(find_game || true)}"

if [[ -z $GAME_FILE && $GUI == 1 ]]; then
    zenity --info --title="Need for Speed: Most Wanted" --width=520 \
        --text="Please select your copy of Need for Speed: Most Wanted (Black Edition) for original Xbox:\n\n• An Xbox disc image (.iso), or\n• default.xbe inside your extracted game directory." 2>/dev/null
    PICK=$(zenity --file-selection --title="NFSMW: Select .iso or default.xbe" \
           --file-filter="Xbox Disc / XBE (*.iso, default.xbe) | *.iso *.ISO default.xbe DEFAULT.XBE" 2>/dev/null) || exit 1
    if [[ ${PICK,,} == *.iso ]]; then
        ln -sf "$PICK" "$HOME_DIR/game/$(basename "$PICK")"
    else
        rmdir "$HOME_DIR/game" 2>/dev/null || true
        [[ -e $HOME_DIR/game ]] || ln -s "$(dirname "$PICK")" "$HOME_DIR/game"
    fi
    GAME_FILE="$PICK"
fi
[[ -n $GAME_FILE ]] || fail "No game files found. Please put your Xbox Need for Speed: Most Wanted Black Edition .iso or extracted folder into:\n  $HOME_DIR/game\nand run nfsmw-linux-build again."
say "Detected game copy: $GAME_FILE"

XBE="$WORK/default.xbe"
if [[ ${GAME_FILE,,} == *.iso ]]; then
    say "Extracting default.xbe from Xbox disc image..."
    python3 -I "$DATA/tools/xdvdfs.py" "$GAME_FILE" default.xbe "$XBE" >>"$LOG" 2>&1 \
        || python3 -I "$DATA/tools/xdvdfs.py" "$GAME_FILE" DEFAULT.XBE "$XBE" >>"$LOG" 2>&1 \
        || fail "default.xbe could not be read from $GAME_FILE (is this a valid Xbox ISO?). See $LOG"
else
    cp -f "$GAME_FILE" "$XBE" || fail "cannot read $GAME_FILE"
fi

IMAGE_SHA=$(sha1sum "$XBE" | cut -d' ' -f1)
say "Executable SHA-1: $IMAGE_SHA"
if [[ $IMAGE_SHA != "$USA_BLACK_SHA1" ]]; then
    say "WARNING: SHA-1 does not match expected USA Black Edition ($USA_BLACK_SHA1)."
    say "Attempting build anyway..."
fi

STAMP="$VERSION $IMAGE_SHA"
if [[ $FORCE == 0 && -x $HOME_DIR/bin/MOSTWANTED && "$(cat "$HOME_DIR/bin/.stamp" 2>/dev/null)" == "$STAMP" ]]; then
    say "Game executable is already up-to-date: $HOME_DIR/bin/MOSTWANTED"
    exit 0
fi

# ------------------------------------------------------------------ Step 1: Recompile
FLAGS="-std=c++20 -O2 -w -fno-strict-aliasing -fsigned-char -march=$MARCH"
KEY=$( { sha1sum "$LIB/xbe_recomp" "$DATA/config/game.toml"; find "$DATA/sdk" -type f \( -name '*.h' -o -name '*.toml' \) | sort | xargs sha1sum; echo "$FLAGS $IMAGE_SHA $($CXX --version | head -n1)"; } | sha1sum | cut -c1-12)
GEN="$WORK/gen-$KEY"
OBJ="$WORK/obj-$KEY"
for d in "$WORK"/gen-* "$WORK"/obj-* "$WORK"/gen; do
    [[ -e $d && $d != "$GEN" && $d != "$OBJ" ]] && rm -rf "$d"
done

say "[1/3] Recompiling Xbox XBE executable to C++ ..."
"$LIB/xbe_recomp" "$DATA/config/game.toml" "$XBE" "$GEN" --xdk "$DATA/sdk/xdk" >>"$LOG" 2>&1 \
    || fail "The recompiler failed. Ensure your copy is Need for Speed: Most Wanted Black Edition. See $LOG"

cmp -s "$GEN/image_symbols.h" "$LIB/image_symbols.h" \
    || fail "Recompiled symbols do not match the host runtime. Check config/game.toml and your XBE version."

# ------------------------------------------------------------------ Step 2: Compile
SOURCES=("$GEN"/x86_func_mapping.cpp "$GEN"/x86_recomp.*.cpp)
TOTAL=${#SOURCES[@]}
if [[ -z $JOBS ]]; then
    MEM_GB=$(awk '/MemAvailable/ {printf "%d", $2/1048576}' /proc/meminfo)
    JOBS=$(( (MEM_GB - 1) / 2 ))
    (( JOBS < 1 )) && JOBS=1
    (( JOBS > $(nproc) )) && JOBS=$(nproc)
fi

DONE=$(find "$OBJ" -name '*.o' 2>/dev/null | wc -l)
if (( DONE >= TOTAL )); then
    say "[2/3] All $TOTAL compiled objects exist from cache: skipping to link stage."
else
    say "[2/3] Compiling $TOTAL parts using $JOBS parallel jobs (one-time process) ..."
fi

mkdir -p "$OBJ"
export CXX MARCH GEN OBJ DATA LOG FLAGS
compile_one() {
    local src="$1" o
    o="$OBJ/$(basename "$src" .cpp).o"
    [[ -f $o && $o -nt $src ]] && return 0
    $CXX $FLAGS -I"$DATA/sdk/runtime" -I"$DATA/sdk/harness/compat" -I"$GEN" -c "$src" -o "$o.tmp" 2>>"$LOG" \
        && mv -f "$o.tmp" "$o"
}
export -f compile_one

progress() {
    local done=0
    while (( done < TOTAL )); do
        done=$(find "$OBJ" -name '*.o' 2>/dev/null | wc -l)
        echo $(( done * 100 / TOTAL ))
        echo "# Compiling NFSMW: $done / $TOTAL modules..."
        sleep 3
        kill -0 "$1" 2>/dev/null || break
    done
}

printf '%s\n' "${SOURCES[@]}" | xargs -P "$JOBS" -I{} bash -c 'compile_one "$@"' _ {} &
CPID=$!

if [[ $GUI == 1 ]]; then
    progress $CPID | zenity --progress --title="Need for Speed: Most Wanted" --width=500 --auto-close --no-cancel \
        --text="Compiling game modules for your PC..." 2>/dev/null &
    wait $CPID; RC=$?
else
    while kill -0 $CPID 2>/dev/null; do
        n=$(find "$OBJ" -name '*.o' 2>/dev/null | wc -l)
        printf '\r      Compiled %d / %d modules' "$n" "$TOTAL"
        sleep 4
    done
    wait $CPID; RC=$?
    echo ""
fi
(( RC == 0 )) || fail "Compilation failed (out of memory? try: nfsmw-linux-build --jobs 1). See $LOG"

# ------------------------------------------------------------------ Step 3: Link
say "[3/3] Linking native Linux executable ..."
echo "extern const char kImageSha1[] = \"$IMAGE_SHA\";" > "$WORK/image_sha1.cpp"
$CXX $FLAGS -c "$WORK/image_sha1.cpp" -o "$WORK/image_sha1.o" 2>>"$LOG" || fail "see $LOG"

OBJS=("$OBJ"/x86_func_mapping.o)
for s in "${SOURCES[@]:1}"; do
    OBJS+=("$OBJ/$(basename "$s" .cpp).o")
done

$CXX -fuse-ld=lld -o "$HOME_DIR/bin/MOSTWANTED.new" "${OBJS[@]}" "$WORK/image_sha1.o" \
    -Wl,--whole-archive "$LIB/libnfsmw_host.a" -Wl,--no-whole-archive \
    -Wl,--start-group $(cat "$LIB/link-libs.txt" | sed "s|^|$LIB/|") -Wl,--end-group \
    "$VK" -lpthread -ldl -lm -lrt >>"$LOG" 2>&1 || fail "Linking failed. See $LOG"

mv -f "$HOME_DIR/bin/MOSTWANTED.new" "$HOME_DIR/bin/MOSTWANTED"
chmod 755 "$HOME_DIR/bin/MOSTWANTED"
echo "$STAMP" > "$HOME_DIR/bin/.stamp"

say ""
say "======================================================================"
say "  Build complete! Native binary ready at:"
say "  $HOME_DIR/bin/MOSTWANTED"
say "  Launch anytime with: nfsmw-linux"
say "======================================================================"
say ""

[[ $GUI == 1 ]] && zenity --info --title="Need for Speed: Most Wanted" --width=420 \
    --text="Build complete!\nNeed for Speed: Most Wanted Black Edition is ready to play." 2>/dev/null &

exit 0
